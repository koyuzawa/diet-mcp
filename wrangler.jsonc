{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diet-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diet-mcp",
      "database_id": "af80187f-9779-4895-b85a-cab42c40510a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
