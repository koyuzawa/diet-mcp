{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diet-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diet-mcp",
      // `npm run db:create` (wrangler d1 create diet-mcp) の出力の database_id に置き換える
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
