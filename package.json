{
  "name": "diet-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "AIダイエットセッション用のリモートMCPサーバー + ダッシュボード (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create diet-mcp",
    "db:migrate": "wrangler d1 migrations apply diet-mcp --remote",
    "db:migrate:local": "wrangler d1 migrations apply diet-mcp --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
